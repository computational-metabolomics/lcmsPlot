    "IonFormula",
    "Area[c-1]", "Area[c-2]", "Height[c-1]", "Height[c-2]",
    "Rt[c-1]", "Rt[c-2]", "ObsMz[c-1]", "ObsMz[c-2]",
    "Grade[c-1]", "Grade[c-2]")

rows <- list(
    c(0, "PRO(0:0)+H", "PRO(0:0)", "PRO", "(0:0)", 116.0706,
      "C5 H10 O2 N1", 24050, 0, 24050, 0, 7.10, 0,
      "116.0704", "", "A", ""),
    c(0, "KYN(0:0)+H", "KYN(0:0)", "KYN", "(0:0)", 209.0921,
