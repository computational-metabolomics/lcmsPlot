## Two compounds, one detected in each study file.
compounds <- data.frame(
    "Compounds ID" = c(1, 2),
    "Name" = c("L-Proline", "L-Kynurenine"),
    "Formula" = c("C5 H9 N O2", "C10 H12 N2 O3"),
