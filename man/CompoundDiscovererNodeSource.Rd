features <- data.frame(
    "Features ID" = c(1, 2),
    "mz" = c(116.0704, 209.0918),
    "Ion" = c("[M+H]+1", "[M+H]+1"),
    "Area" = c(24050, 18700),
    "RT [min]" = c(7.10, 6.10),
